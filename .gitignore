# ══════════════════════════════════════════════════════
#  NeuroGraph — .gitignore
# ══════════════════════════════════════════════════════

# ── Python cache ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ───────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Trained model binaries → tracked via Git LFS ─────────
# (see .gitattributes — *.pkl files are stored in LFS, not ignored)

# ── Cached feature matrix (auto-generated) ─────────────
models/features_cache.csv

# ── Generated plots (auto-generated by model.py) ───────
models/feature_importance.png
models/roc_curve.png

# ── Raw dataset (too large for git, share separately) ──
data/

# ── Jupyter / IPython ──────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Distribution / packaging ───────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing & coverage ─────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS noise ───────────────────────────────────────────
# Windows
Thumbs.db
desktop.ini
ehthumbs.db

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ── IDE / editor folders ───────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Logs & temporary files ─────────────────────────────
*.log
*.tmp
*.bak
